doctype html
html
    head
        title= title
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        h1 Custom Objects Table - Pets
        a(href="/update-cobj") Add to this table
        
        table
            thead
                tr
                    th Pet Name
                    th Pet Type
                    th Pet Age
            tbody
                each item in data
                    tr
                        td= item.properties.pet_name
                        td= item.properties.pet_type
                        td= item.properties.pet_age