doctype html
html
    head
        title= title
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        .form-wrapper
            h1 Create / Update Pet Record
            a(href="/") Return to the homepage
            
            form(action="/update-cobj" method="POST")
                label(for="pet_name") Pet Name
                input(type="text" name="pet_name" id="pet_name" required)

                label(for="pet_type") Pet Type
                input(type="text" name="pet_type" id="pet_type" required)

                label(for="pet_age") Pet Age
                input(type="text" name="pet_age" id="pet_age" required)

                input(type="submit" value="Submit")